# locations

nbi:Location-Global a saref:FeatureOfInterest ;
    rdfs:label "Global — l’Albufera"@en ,
               "Global — l’Albufera"@es ,
               "Global — l’Albufera"@ca-valencia ;
    rdfs:comment "Represents the l'Albufera lake as a whole. All three KEIs are properties of interest of this location; KEI-3 is exclusively global. Flow gauging station records are assigned to this location as context: they cannot be attributed to any sub-location and do not enter KEI scoring."@en ,
                 "Representa el lago de l'Albufera en su conjunto. Los tres KEI son propiedades de interés de esta ubicación; el KEI-3 es exclusivamente global. Los registros de las estaciones de aforo se asignan a esta ubicación como información contextual: no pueden atribuirse a ninguna sububicación y no intervienen en la puntuación de los KEI."@es ,
                 "Representa el llac de l'Albufera en conjunt. Els tres KEI són propietats d'interés d'esta ubicació; el KEI-3 és exclusivament global. Els registres de les estacions d'aforament s'assignen a esta ubicació com a informació contextual: no es poden atribuir a cap sububicació i no intervenen en la puntuació dels KEI."@ca-valencia ;
    saref:hasPropertyOfInterest nb:KEI-1, nb:KEI-2, nb:KEI-3 ;
    geo:hasBoundingBox nbi:Geometry-Global ;
    nb:hasAquaticBoundingBox nbi:Geometry-Global-Aquatic .
nbi:Geometry-Global a geo:Geometry ;
    geo:asWKT "POLYGON((-0.398608 39.293126, -0.295952 39.293126, -0.295952 39.398265, -0.398608 39.398265, -0.398608 39.293126))"^^geo:wktLiteral .

nbi:Location-North a saref:FeatureOfInterest ;
    rdfs:label "North"@en ,
               "Norte"@es ,
               "Nord"@ca-valencia ;
    saref:hasPropertyOfInterest nb:KEI-1, nb:KEI-2 ;
    geo:hasBoundingBox nbi:Geometry-North ;
    nb:hasAquaticBoundingBox nbi:Geometry-North-Aquatic .
nbi:Geometry-North a geo:Geometry ;
    geo:asWKT "POLYGON((-0.350868 39.358989, -0.334687 39.358989, -0.334687 39.376042, -0.350868 39.376042, -0.350868 39.358989))"^^geo:wktLiteral .

nbi:Location-South a saref:FeatureOfInterest ;
    rdfs:label "South"@en ,
               "Sur"@es ,
               "Sud"@ca-valencia ;
    saref:hasPropertyOfInterest nb:KEI-1, nb:KEI-2 ;
    geo:hasBoundingBox nbi:Geometry-South ;
    nb:hasAquaticBoundingBox nbi:Geometry-South-Aquatic .
nbi:Geometry-South a geo:Geometry ;
    geo:asWKT "POLYGON((-0.339319 39.305529, -0.331220 39.305529, -0.331220 39.311855, -0.339319 39.311855, -0.339319 39.305529))"^^geo:wktLiteral .

nbi:Location-SouthWest a saref:FeatureOfInterest ;
    rdfs:label "South-West"@en ,
               "Suroeste"@es ,
               "Sud-oest"@ca-valencia ;
    saref:hasPropertyOfInterest nb:KEI-1, nb:KEI-2 ;
    geo:hasBoundingBox nbi:Geometry-SouthWest ;
    nb:hasAquaticBoundingBox nbi:Geometry-SouthWest-Aquatic .
nbi:Geometry-SouthWest a geo:Geometry ;
    geo:asWKT "POLYGON((-0.372886 39.302923, -0.364667 39.302923, -0.364667 39.308236, -0.372886 39.308236, -0.372886 39.302923))"^^geo:wktLiteral .

# Water tiles: one stretch of open lagoon paired with each of the four
# locations above, via nb:hasAquaticBoundingBox. The satellite water quality
# indices (chlorophyll, Secchi disk depth, phycocyanin) are measured over the
# tile, not over the location's own box.
#
# A tile is NOT a sub-area of its location. Only Global contains its tile;
# North, South and South-West sit in the rice fields and are disjoint from the
# water paired with them. Each location is paired with the nearest open lagoon, and its reading
# is reported under the location's name.

nbi:Geometry-Global-Aquatic a geo:Geometry ;
    geo:asWKT "POLYGON((-0.364609 39.327127, -0.335083 39.327127, -0.335083 39.349299, -0.364609 39.349299, -0.364609 39.327127))"^^geo:wktLiteral .
nbi:Geometry-North-Aquatic a geo:Geometry ;
    geo:asWKT "POLYGON((-0.350868 39.339874, -0.329075 39.339874, -0.329075 39.352050, -0.350868 39.352050, -0.350868 39.339874))"^^geo:wktLiteral .
nbi:Geometry-South-Aquatic a geo:Geometry ;
    geo:asWKT "POLYGON((-0.342121 39.325932, -0.331993 39.325932, -0.331993 39.334563, -0.342121 39.334563, -0.342121 39.325932))"^^geo:wktLiteral .
nbi:Geometry-SouthWest-Aquatic a geo:Geometry ;
    geo:asWKT "POLYGON((-0.367270 39.312254, -0.358944 39.312254, -0.358944 39.318230, -0.367270 39.318230, -0.367270 39.312254))"^^geo:wktLiteral .

