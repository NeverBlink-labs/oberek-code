# baseline values for the environmental parameters used in KEI calculation
# Provenance of each value is given with nb:baselineSource* and nb:thresholdSource*.

nbi:chlorophyll-baseline a nb:PropertyBaseline ;
    nb:forProperty nb:chlorophyll ;
    nb:baselineValue "5.3"^^xsd:decimal ;
    nb:warningThreshold "88.68"^^xsd:decimal ;
    nb:criticalThreshold "354.72"^^xsd:decimal ;
    nb:deviationDirection nb:Above ;
    nb:bidirectional "false"^^xsd:boolean ;
    nb:baselineSourceType "Regulation / ecological-status framework"@en ,
                          "Normativa / marco de estado ecológico"@es ,
                          "Normativa / marc d'estat ecològic"@ca-valencia ;
    nb:baselineSource "Royal Decree 817/2015, Annex III, B.2, lake type L-T28 (chlorophyll-a reference)."@en ,
                      "Real Decreto 817/2015, anexo III, B.2, tipo de lago L-T28 (referencia de clorofila-a)."@es ,
                      "Reial decret 817/2015, annex III, B.2, tipus de llac L-T28 (referència de clorofil·la-a)."@ca-valencia ;
    nb:thresholdSourceType "Regulation-informed derivation"@en ,
                           "Derivación basada en la normativa"@es ,
                           "Derivació basada en la normativa"@ca-valencia ;
    nb:thresholdSource "OBEREK warning and critical boundaries derived from selected ecological quality ratios (EQRs) for L-T28 in RD 817/2015."@en ,
                       "Umbrales de aviso y crítico de OBEREK derivados de determinados cocientes de calidad ecológica (EQR) para L-T28 del RD 817/2015."@es ,
                       "Llindars d’avís i crític d’OBEREK derivats de determinats quocients de qualitat ecològica (EQR) per a L-T28 del RD 817/2015."@ca-valencia .

nbi:secchiDiskDepth-baseline a nb:PropertyBaseline ;
    nb:forProperty nb:secchiDiskDepth ;
    nb:baselineValue "0.60"^^xsd:decimal ;
    nb:warningThreshold "33.33"^^xsd:decimal ;
    nb:criticalThreshold "50"^^xsd:decimal ;
    nb:deviationDirection nb:Below ;
    nb:bidirectional "false"^^xsd:boolean ;
    nb:baselineSourceType "Scientific literature + expert adaptation"@en ,
                          "Literatura científica + adaptación de expertos"@es ,
                          "Literatura científica + adaptació d'experts"@ca-valencia ;
    nb:baselineSource "Sòria-Perpinyà et al. (2020), Limnetica 39(1):373–386."@en ,
                      "Sòria-Perpinyà et al. (2020), Limnetica 39(1):373–386."@es ,
                      "Sòria-Perpinyà et al. (2020), Limnetica 39(1):373–386."@ca-valencia ;
    nb:thresholdSourceType "Project / expert judgement"@en ,
                           "Criterio del proyecto / de expertos"@es ,
                           "Criteri del projecte / d'experts"@ca-valencia ;
    nb:thresholdSource "OBEREK operational thresholds (provisional)."@en ,
                       "Umbrales operativos de OBEREK (provisionales)."@es ,
                       "Llindars operatius d'OBEREK (provisionals)."@ca-valencia .

nbi:phycocyanin-baseline a nb:PropertyBaseline ;
    nb:forProperty nb:phycocyanin ;
    nb:baselineValue "30"^^xsd:decimal ;
    nb:warningThreshold "0.01"^^xsd:decimal ;
    nb:criticalThreshold "200"^^xsd:decimal ;
    nb:deviationDirection nb:Above ;
    nb:bidirectional "false"^^xsd:boolean ;
    nb:baselineSourceType "Scientific literature + international guidance"@en ,
                          "Literatura científica + guías internacionales"@es ,
                          "Literatura científica + guies internacionals"@ca-valencia ;
    nb:baselineSource "Sòria-Perpinyà et al. (2020), STOTEN 698:134305; WHO (1999); Brient et al. (2008)."@en ,
                      "Sòria-Perpinyà et al. (2020), STOTEN 698:134305; WHO (1999); Brient et al. (2008)."@es ,
                      "Sòria-Perpinyà et al. (2020), STOTEN 698:134305; WHO (1999); Brient et al. (2008)."@ca-valencia ;
    nb:thresholdSourceType "Scientific/guidance-informed operational classification"@en ,
                           "Clasificación operativa basada en literatura científica y guías"@es ,
                           "Classificació operativa basada en literatura científica i guies"@ca-valencia ;
    nb:thresholdSource "Sòria-Perpinyà et al. (2020), Science of the Total Environment 698, 134305, Table 2: phycocyanin surveillance levels derived using Brient et al. (2008) from WHO (1999) guidance. Adapted as OBEREK operational boundaries, not toxin or legal ecological-status limits."@en ,
                       "Sòria-Perpinyà et al. (2020), Science of the Total Environment 698, 134305, tabla 2: niveles de vigilancia de ficocianina derivados mediante Brient et al. (2008) de las guías de la OMS (1999). Adaptados como límites operativos de OBEREK, no como límites de toxinas o de estado ecológico normativo."@es ,
                       "Sòria-Perpinyà et al. (2020), Science of the Total Environment 698, 134305, taula 2: nivells de vigilància de ficocianina derivats mitjançant Brient et al. (2008) de les guies de l’OMS (1999). Adaptats com a límits operatius d’OBEREK, no com a límits de toxines o d’estat ecològic normatiu."@ca-valencia .

