@prefix cc: <http://creativecommons.org/ns#> .
@prefix s4mari: <https://saref.etsi.org/saref4mari/> .
@prefix s4watr: <https://saref.etsi.org/saref4watr/> .
@prefix qudt_qk: <http://qudt.org/vocab/quantitykind/> .
@prefix nb: <https://neverblink.eu/ontologies/oberek/> .
@prefix wmdr_terr: <http://codes.wmo.int/wmdr/ObservedVariableTerrestrial/> .
@prefix wmo: <http://codes.wmo.int/common/quantity-kind/> .
@prefix bufr4_b13: <http://codes.wmo.int/bufr4/b/13/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wmdr: <http://codes.wmo.int/wmdr/ObservedVariableAtmosphere/> .

# attribution
# Who published each source's data and under which licence. Each data-source
# device below points here with dcterms:publisher and dcterms:license, and names
# what to credit with cc:attributionName (or nb:attributionText where the licence
# fixes the wording).

nbi:Publisher-OBEREK a dcterms:Agent ;
    rdfs:label "OBEREK"@en , "OBEREK"@es , "OBEREK"@ca-valencia .

nbi:Publisher-UPV a dcterms:Agent ;
    rdfs:label "OBEREK / Universitat Politècnica de València (UPV)"@en ,
               "OBEREK / Universitat Politècnica de València (UPV)"@es ,
               "OBEREK / Universitat Politècnica de València (UPV)"@ca-valencia .

nbi:Publisher-FundacioAssut a dcterms:Agent ;
    rdfs:label "Fundació Assut"@en , "Fundació Assut"@es , "Fundació Assut"@ca-valencia .

nbi:Publisher-CHJ a dcterms:Agent ;
    rdfs:label "Confederación Hidrográfica del Júcar (CHJ)"@en ,
               "Confederación Hidrográfica del Júcar (CHJ)"@es ,
               "Confederación Hidrográfica del Júcar (CHJ)"@ca-valencia .

nbi:Publisher-Copernicus a dcterms:Agent ;
    rdfs:label "European Union, Copernicus programme (ESA)"@en ,
               "Unión Europea, programa Copernicus (ESA)"@es ,
               "Unió Europea, programa Copernicus (ESA)"@ca-valencia .

<https://creativecommons.org/licenses/by/4.0/> a dcterms:LicenseDocument ;
    rdfs:label "CC BY 4.0"@en , "CC BY 4.0"@es , "CC BY 4.0"@ca-valencia .

<https://sentinels.copernicus.eu/documents/247904/690755/Sentinel_Data_Legal_Notice> a dcterms:LicenseDocument ;
    rdfs:label "Legal notice on the use of Copernicus Sentinel Data and Service Information"@en ,
               "Aviso legal sobre el uso de los datos Copernicus Sentinel y la información de los servicios"@es ,
               "Avís legal sobre l'ús de les dades Copernicus Sentinel i la informació dels serveis"@ca-valencia .

<https://www.chj.es/es-es/ciudadano/Reutilizacion/Paginas/Condicionesdeuso.aspx> a dcterms:LicenseDocument ;
    rdfs:label "CHJ conditions of use"@en ,
               "Condiciones de uso de la CHJ"@es ,
               "Condicions d'ús de la CHJ"@ca-valencia .

# IoT sensors

# north station
nbi:Estacion_North a saref:Device ;
    rdfs:label "IoT Station North"@en ,
               "Estación IoT Norte"@es ,
               "Estació IoT Nord"@ca-valencia ;
    saref:hasIdentifier "Estacion_North" ;
    dcterms:publisher nbi:Publisher-UPV ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    cc:attributionName "OBEREK / UPV" ;
    rdfs:comment "IoT Sensor site deployed to measure aquatic parameters."@en ,
                 "Emplazamiento de sensores IoT desplegado para medir parámetros acuáticos."@es ,
                 "Emplaçament de sensors IoT desplegat per a mesurar paràmetres aquàtics."@ca-valencia ;
    saref:consistsOf nbi:Estacion_North-turbidity,
                     nbi:Estacion_North-ec,
                     nbi:Estacion_North-ph,
                     nbi:Estacion_North-oxygen .

nbi:Estacion_North-turbidity a saref:Sensor ;
    rdfs:label "Turbidity sensor"@en ,
               "Sensor de turbidez"@es ,
               "Sensor de terbolesa"@ca-valencia ;
    saref:observes s4watr:Turbidity, s4mari:WaterTemperature, nbi:Location-North .

nbi:Estacion_North-ec a saref:Sensor ;
    rdfs:label "Electrical conductivity sensor"@en ,
               "Sensor de conductividad eléctrica"@es ,
               "Sensor de conductivitat elèctrica"@ca-valencia ;
    saref:observes s4mari:WaterConductivity, s4watr:TotalDissolvedSolids, s4mari:Salinity, s4mari:WaterTemperature, nbi:Location-North .

nbi:Estacion_North-ph a saref:Sensor ;
    rdfs:label "pH sensor"@en ,
               "Sensor de pH"@es ,
               "Sensor de pH"@ca-valencia ;
    saref:observes qudt_qk:Acidity, s4mari:WaterTemperature, nbi:Location-North .

nbi:Estacion_North-oxygen a saref:Sensor ;
    rdfs:label "Dissolved oxygen sensor"@en ,
               "Sensor de oxígeno disuelto"@es ,
               "Sensor d'oxigen dissolt"@ca-valencia ;
    saref:observes bufr4_b13:083, s4mari:WaterTemperature, nbi:Location-North .

