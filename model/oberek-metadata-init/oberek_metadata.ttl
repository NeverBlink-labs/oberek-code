# polls

nbi:OBEREK_Dashboard a saref:Device ;
    rdfs:label "OBEREK Dashboard"@en ,
               "Plataforma OBEREK"@es ,
               "Plataforma OBEREK"@ca-valencia ;
    saref:hasIdentifier "OBEREK_Dashboard" ;
    dcterms:publisher nbi:Publisher-OBEREK ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    cc:attributionName "OBEREK" ;
    rdfs:comment "Feedback mechanism capturing community satisfaction scores and respondent profiles."@en ,
                 "Mecanismo de retroalimentación que recoge las puntuaciones de satisfacción de la comunidad y los perfiles de los encuestados."@es ,
                 "Mecanisme de retroalimentació que recull les puntuacions de satisfacció de la comunitat i els perfils dels enquestats."@ca-valencia ;
    saref:consistsOf nbi:OBEREK_Dashboard_Sensor .

nbi:OBEREK_Dashboard_Sensor a saref:Sensor ;
    rdfs:label "Community Poll Sensor"@en ,
               "Sensor de Encuesta Comunitaria"@es ,
               "Sensor d'Enquesta Comunitària"@ca-valencia ;
    saref:observes nb:satisfactionScore, nb:respondentCategory, nbi:Location-Global .

nbi:OBEREK_ManualPoll a saref:Device ;
    rdfs:label "OBEREK Manual Poll Ingestion"@en ,
               "Ingesta Manual de Encuestas OBEREK"@es ,
               "Ingesta Manual d'Enquestes OBEREK"@ca-valencia ;
    saref:hasIdentifier "OBEREK_ManualPoll" ;
    dcterms:publisher nbi:Publisher-OBEREK ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    cc:attributionName "OBEREK" ;
    rdfs:comment "Batch ingestion device for community-poll submissions collected offline (e.g. hand surveys with farmers)."@en ,
                 "Dispositivo de ingesta por lotes de respuestas de encuestas a la comunidad recogidas fuera de línea, por ejemplo mediante encuestas presenciales a agricultores."@es ,
                 "Dispositiu d’ingesta per lots de respostes d’enquestes a la comunitat recollides fora de línia, per exemple mitjançant enquestes presencials a agricultors."@ca-valencia ;
    saref:consistsOf nbi:OBEREK_ManualPoll_Sensor .

nbi:OBEREK_ManualPoll_Sensor a saref:Sensor ;
    rdfs:label "Manual Community Poll Sensor"@en ,
               "Sensor de Encuesta Comunitaria Manual"@es ,
               "Sensor d'Enquesta Comunitària Manual"@ca-valencia ;
    saref:observes nb:satisfactionScore, nb:respondentCategory, nbi:Location-Global .

# Questions 1–4 are numeric rating questions feeding nb:satisfactionScore; question 5 is
# the categorical respondent-category question feeding nb:respondentCategory
nbi:CommunityPoll a nb:Poll ;
    saref:hasIdentifier "poll_v1" ;
    nb:hasQuestion nbi:CommunityPoll-q1,
                   nbi:CommunityPoll-q2,
                   nbi:CommunityPoll-q3,
                   nbi:CommunityPoll-q4,
                   nbi:CommunityPoll-q5 .

# Each rating question (q1–q4) carries its wording (rdfs:label) and lists its own
# nb:AnswerOption individuals.
# The separate "Don't know / No opinion" choice carries optionCode "6", omits nb:mapsToValue,
# and is excluded from the satisfaction average. Question q5 reuses the
# nb:RespondentCategory enumeration as its answer options.

nbi:CommunityPoll-q1 a nb:PollQuestion ;
    saref:hasIdentifier "q_id1" ;
    nb:assessesProperty nb:satisfactionScore ;
    rdfs:label "Based on your perception, how would you rate the current water quality of the Albufera region?"@en ,
               "Según su percepción, ¿cómo calificaría la calidad actual del agua de la región de l'Albufera?"@es ,
               "Segons la seua percepció, com valoraria la qualitat actual de l'aigua de la regió de l'Albufera?"@ca-valencia ;
    nb:hasAnswerOption nbi:CommunityPoll-q1-1,
                       nbi:CommunityPoll-q1-2,
                       nbi:CommunityPoll-q1-3,
                       nbi:CommunityPoll-q1-4,
                       nbi:CommunityPoll-q1-5,
                       nbi:CommunityPoll-q1-dk .

nbi:CommunityPoll-q1-1 a nb:AnswerOption ;
    nb:optionCode "1" ;
    nb:mapsToValue "1"^^xsd:integer ;
    rdfs:label "Critical"@en , "Crítica"@es , "Crítica"@ca-valencia .
nbi:CommunityPoll-q1-2 a nb:AnswerOption ;
    nb:optionCode "2" ;
    nb:mapsToValue "2"^^xsd:integer ;
    rdfs:label "Poor"@en , "Deficiente"@es , "Deficient"@ca-valencia .
nbi:CommunityPoll-q1-3 a nb:AnswerOption ;
    nb:optionCode "3" ;
    nb:mapsToValue "3"^^xsd:integer ;
    rdfs:label "Moderate concern"@en , "Preocupación moderada"@es , "Preocupació moderada"@ca-valencia .
nbi:CommunityPoll-q1-4 a nb:AnswerOption ;
    nb:optionCode "4" ;
    nb:mapsToValue "4"^^xsd:integer ;
    rdfs:label "Good"@en , "Buena"@es , "Bona"@ca-valencia .
nbi:CommunityPoll-q1-5 a nb:AnswerOption ;
    nb:optionCode "5" ;
    nb:mapsToValue "5"^^xsd:integer ;
    rdfs:label "Very good"@en , "Muy buena"@es , "Molt bona"@ca-valencia .
nbi:CommunityPoll-q1-dk a nb:AnswerOption ;
    nb:optionCode "6" ;
    rdfs:label "Don't know / No opinion"@en , "No sé / Sin opinión"@es , "No ho sé / Sense opinió"@ca-valencia .

nbi:CommunityPoll-q2 a nb:PollQuestion ;
    saref:hasIdentifier "q_id2" ;
    nb:assessesProperty nb:satisfactionScore ;
    rdfs:label "How would you rate the current ecological condition of habitats in the l’Albufera region, considering fish, aquatic birds, vegetation and other organisms?"@en ,
               "¿Cómo valoraría el estado ecológico actual de los hábitats de la región de l’Albufera, teniendo en cuenta los peces, las aves acuáticas, la vegetación y otros organismos?"@es ,
               "Com valoraria l’estat ecològic actual dels hàbitats de la regió de l’Albufera, tenint en compte els peixos, les aus aquàtiques, la vegetació i altres organismes?"@ca-valencia ;
    nb:hasAnswerOption nbi:CommunityPoll-q2-1,
                       nbi:CommunityPoll-q2-2,
                       nbi:CommunityPoll-q2-3,
                       nbi:CommunityPoll-q2-4,
                       nbi:CommunityPoll-q2-5,
                       nbi:CommunityPoll-q2-dk .

nbi:CommunityPoll-q2-1 a nb:AnswerOption ;
    nb:optionCode "1" ;
    nb:mapsToValue "1"^^xsd:integer ;
    rdfs:label "Critical"@en , "Crítica"@es , "Crítica"@ca-valencia .
nbi:CommunityPoll-q2-2 a nb:AnswerOption ;
    nb:optionCode "2" ;
    nb:mapsToValue "2"^^xsd:integer ;
    rdfs:label "Poor"@en , "Deficiente"@es , "Deficient"@ca-valencia .
nbi:CommunityPoll-q2-3 a nb:AnswerOption ;
    nb:optionCode "3" ;
    nb:mapsToValue "3"^^xsd:integer ;
    rdfs:label "Moderate concern"@en , "Preocupación moderada"@es , "Preocupació moderada"@ca-valencia .
nbi:CommunityPoll-q2-4 a nb:AnswerOption ;
    nb:optionCode "4" ;
    nb:mapsToValue "4"^^xsd:integer ;
    rdfs:label "Good"@en , "Buena"@es , "Bona"@ca-valencia .
nbi:CommunityPoll-q2-5 a nb:AnswerOption ;
    nb:optionCode "5" ;
    nb:mapsToValue "5"^^xsd:integer ;
    rdfs:label "Very good"@en , "Muy buena"@es , "Molt bona"@ca-valencia .
nbi:CommunityPoll-q2-dk a nb:AnswerOption ;
    nb:optionCode "6" ;
    rdfs:label "Don't know / No opinion"@en , "No sé / Sin opinión"@es , "No ho sé / Sense opinió"@ca-valencia .

nbi:CommunityPoll-q3 a nb:PollQuestion ;
    saref:hasIdentifier "q_id3" ;
    nb:assessesProperty nb:satisfactionScore ;
    rdfs:label "In your opinion, how effective are the ongoing restoration activities in improving the ecological state of the Albufera region?"@en ,
               "En su opinión, ¿en qué medida son efectivas las actividades de restauración en curso para mejorar el estado ecológico de la región de l'Albufera?"@es ,
               "En la seua opinió, en quina mesura són efectives les activitats de restauració en curs per a millorar l'estat ecològic de la regió de l'Albufera?"@ca-valencia ;
    nb:hasAnswerOption nbi:CommunityPoll-q3-1,
                       nbi:CommunityPoll-q3-2,
                       nbi:CommunityPoll-q3-3,
                       nbi:CommunityPoll-q3-4,
                       nbi:CommunityPoll-q3-5,
                       nbi:CommunityPoll-q3-dk .

nbi:CommunityPoll-q3-1 a nb:AnswerOption ;
    nb:optionCode "1" ;
    nb:mapsToValue "1"^^xsd:integer ;
    rdfs:label "Not effective"@en , "No efectivas"@es , "Gens efectives"@ca-valencia .
nbi:CommunityPoll-q3-2 a nb:AnswerOption ;
    nb:optionCode "2" ;
    nb:mapsToValue "2"^^xsd:integer ;
    rdfs:label "Barely effective"@en , "Apenas efectivas"@es , "A penes efectives"@ca-valencia .
nbi:CommunityPoll-q3-3 a nb:AnswerOption ;
    nb:optionCode "3" ;
    nb:mapsToValue "3"^^xsd:integer ;
    rdfs:label "Somewhat effective"@en , "Algo efectivas"@es , "Una mica efectives"@ca-valencia .
nbi:CommunityPoll-q3-4 a nb:AnswerOption ;
    nb:optionCode "4" ;
    nb:mapsToValue "4"^^xsd:integer ;
    rdfs:label "Effective"@en , "Efectivas"@es , "Efectives"@ca-valencia .
nbi:CommunityPoll-q3-5 a nb:AnswerOption ;
    nb:optionCode "5" ;
    nb:mapsToValue "5"^^xsd:integer ;
    rdfs:label "Very effective"@en , "Muy efectivas"@es , "Molt efectives"@ca-valencia .
nbi:CommunityPoll-q3-dk a nb:AnswerOption ;
    nb:optionCode "6" ;
    rdfs:label "Don't know / No opinion"@en , "No sé / Sin opinión"@es , "No ho sé / Sense opinió"@ca-valencia .

nbi:CommunityPoll-q4 a nb:PollQuestion ;
    saref:hasIdentifier "q_id4" ;
    nb:assessesProperty nb:satisfactionScore ;
    rdfs:label "In your opinion, are the current restoration activities focusing on the most important issues and areas of the Albufera region?"@en ,
               "En su opinión, ¿se están centrando las actividades de restauración actuales en los problemas y las áreas más importantes de la región de l'Albufera?"@es ,
               "En la seua opinió, s'estan centrant les activitats de restauració actuals en els problemes i les àrees més importants de la regió de l'Albufera?"@ca-valencia ;
    nb:hasAnswerOption nbi:CommunityPoll-q4-1,
                       nbi:CommunityPoll-q4-2,
                       nbi:CommunityPoll-q4-3,
                       nbi:CommunityPoll-q4-4,
                       nbi:CommunityPoll-q4-5,
                       nbi:CommunityPoll-q4-dk .

nbi:CommunityPoll-q4-1 a nb:AnswerOption ;
    nb:optionCode "1" ;
    nb:mapsToValue "1"^^xsd:integer ;
    rdfs:label "No, wrong focus"@en , "No, con una orientación equivocada"@es , "No, amb una orientació equivocada"@ca-valencia .
nbi:CommunityPoll-q4-2 a nb:AnswerOption ;
    nb:optionCode "2" ;
    nb:mapsToValue "2"^^xsd:integer ;
    rdfs:label "No, poorly focused"@en , "No, mal enfocadas"@es , "No, mal enfocades"@ca-valencia .
nbi:CommunityPoll-q4-3 a nb:AnswerOption ;
    nb:optionCode "3" ;
    nb:mapsToValue "3"^^xsd:integer ;
    rdfs:label "Somewhat focused"@en , "Algo enfocadas"@es , "Una mica enfocades"@ca-valencia .
nbi:CommunityPoll-q4-4 a nb:AnswerOption ;
    nb:optionCode "4" ;
    nb:mapsToValue "4"^^xsd:integer ;
    rdfs:label "Yes, mostly focused"@en , "Sí, mayormente enfocadas"@es , "Sí, majoritàriament enfocades"@ca-valencia .
nbi:CommunityPoll-q4-5 a nb:AnswerOption ;
    nb:optionCode "5" ;
    nb:mapsToValue "5"^^xsd:integer ;
    rdfs:label "Yes, well-focused"@en , "Sí, bien enfocadas"@es , "Sí, ben enfocades"@ca-valencia .
nbi:CommunityPoll-q4-dk a nb:AnswerOption ;
    nb:optionCode "6" ;
    rdfs:label "Don't know / No opinion"@en , "No sé / Sin opinión"@es , "No ho sé / Sense opinió"@ca-valencia .

nbi:CommunityPoll-q5 a nb:PollQuestion ;
    saref:hasIdentifier "q_id5" ;
    nb:assessesProperty nb:respondentCategory ;
    rdfs:label "How would you describe your main connection to the Albufera region?"@en ,
               "¿Cómo describiría su principal conexión con la región de l'Albufera?"@es ,
               "Com descriuria la seua principal connexió amb la regió de l'Albufera?"@ca-valencia ;
    nb:hasAnswerOption nb:LocalResident,
                       nb:PrimarySectorWorker,
                       nb:LocalBusinessRepresentative,
                       nb:Researcher,
                       nb:PublicOfficial,
                       nb:OtherRespondent .

# flow gauging stations (CHJ)
# The six stations of the Confederación Hidrográfica del Júcar dataset
# "Estaciones de aforo de L'Albufera" (F56). Names and coordinates come from that
# dataset; the source gives UTM ETRS89 zone 30N, converted here to WGS84 lon/lat.

nbi:station-08A01 a saref:Device ;
    rdfs:label "Flow Gauging Station 08A01 — Albufera Lake Level"@en ,
               "Estación de aforo 08A01 — Nivel del lago de l’Albufera"@es ,
               "Estació d’aforament 08A01 — Nivell del llac de l’Albufera"@ca-valencia ;
    saref:hasIdentifier "08A01" ;
    dcterms:publisher nbi:Publisher-CHJ ;
    dcterms:license <https://www.chj.es/es-es/ciudadano/Reutilizacion/Paginas/Condicionesdeuso.aspx> ;
    cc:attributionName "Confederación Hidrográfica del Júcar (CHJ)" ;
    nb:requiresLastUpdateDate true ;
    rdfs:comment "Flow gauging station monitoring flow volume, flow rate, and water level."@en ,
                 "Estación de aforo que monitoriza el volumen de agua, el caudal y el nivel del agua."@es ,
