    saref:consistsOf nbi:Estacion_South-turbidity,
                     nbi:Estacion_South-ec,
                     nbi:Estacion_South-ph,
                     nbi:Estacion_South-oxygen .

nbi:Estacion_South-turbidity a saref:Sensor ;
    rdfs:label "Turbidity sensor"@en ,
