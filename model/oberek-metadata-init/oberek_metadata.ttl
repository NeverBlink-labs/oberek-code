# rice blast risk index (PRI) — piriculariosis, caused by Pyricularia oryzae.
# One calculator per station-backed location: only South (Tancat de l'Estell).
# North, Global and South-West have no weather station.

nbi:PyriculariaRisk_System a saref:Device ;
    rdfs:label "Rice Blast Risk System"@en ,
               "Sistema de Riesgo de Piriculariosis"@es ,
               "Sistema de Risc de Piriculariosi"@ca-valencia ;
    saref:hasIdentifier "PyriculariaRisk_System" ;
    dcterms:publisher nbi:Publisher-OBEREK ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    cc:attributionName "OBEREK" ;
    rdfs:comment "System calculating the Rice Blast Risk Index (PRI) — the risk of rice blast, or piriculariosis, caused by Pyricularia oryzae — from agrometeorological inputs."@en ,
                 "Sistema que calcula el índice de riesgo de piriculariosis (PRI), causada por Pyricularia oryzae, a partir de datos agrometeorológicos."@es ,
                 "Sistema que calcula l’índex de risc de piriculariosi (PRI), causada per Pyricularia oryzae, a partir de dades agrometeorològiques."@ca-valencia ;
    saref:consistsOf nbi:PyriculariaRisk_Calculator-South .

nbi:PyriculariaRisk_Calculator-South a saref:Sensor ;
    rdfs:label "Rice Blast Risk Calculator — South"@en ,
               "Calculadora de Riesgo de Piriculariosis — Sur"@es ,
               "Calculadora de Risc de Piriculariosi — Sud"@ca-valencia ;
    rdfs:comment "Derives the Rice Blast Risk Index for the South location from the Tancat de l'Estell weather station observations."@en ,
                 "Deriva el Índice de Riesgo de Piriculariosis para la ubicación Sur a partir de las observaciones de la estación meteorológica de Tancat de l'Estell."@es ,
                 "Deriva l'Índex de Risc de Piriculariosi per a la ubicació Sud a partir de les observacions de l'estació meteorològica del Tancat de l'Estell."@ca-valencia ;
    saref:observes nb:pyricularia_risk_index, nbi:Location-South .

