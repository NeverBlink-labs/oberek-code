                            "Turbidez"@es ,
                            "Terbolesa"@ca-valencia .

wmdr_terr:12252 a skos:Concept ;
    qudt:applicableUnit unit:M ;
        rdfs:label       "Water level"@en ,
                         "Nivel del agua"@es ,
                         "Nivell de l'aigua"@ca-valencia ;
        dcterms:description  "Elevation of the free water surface of a water body relative to a reference datum (synonym: stage, gage height). [Based on 'water level' in International Glossary of Hydrology (WMO-No. 385). 2012 edition.]"@en ,
                             "Elevación de la superficie libre del agua de una masa de agua respecto a un datum de referencia (sinónimos: nivel hidrométrico, altura de escala). [Basado en «water level» del International Glossary of Hydrology (WMO-No. 385), edición de 2012.]"@es ,
                             "Elevació de la superfície lliure de l'aigua d'una massa d'aigua respecte a un datum de referència (sinònims: nivell hidromètric, altura d'escala). [Basat en «water level» de l'International Glossary of Hydrology (WMO-No. 385), edició de 2012.]"@ca-valencia ;
        skos:notation    "12252" .

wmdr:12312 a skos:Concept ;
    qudt:applicableUnit unit:W-PER-M2 ;
        rdfs:label       "Solar total irradiance"@en ,
                         "Irradiancia solar total"@es ,
                         "Irradiància solar total"@ca-valencia ;
        dcterms:description  "Spectrally integrated flux density of radiation received from the sun at the top of the atmosphere. Also called 'Total solar irradiance (TSI)'."@en ;
        skos:notation    "12312" ;
        owl:deprecated   true ;
        dcterms:isReplacedBy wmdr:573 ;
        dcterms:modified "2026-10-13"^^xsd:date ;
        skos:historyNote "Deprecated in OBEREK on 2026-10-13: the station measures surface radiation, not top-of-atmosphere irradiance."@en ,
                         "Obsoleto en OBEREK desde el 2026-10-13: la estación mide la radiación en superficie, no la irradiancia en el límite de la atmósfera."@es ,
                         "Obsolet en OBEREK des del 2026-10-13: l'estació mesura la radiació en superfície, no la irradiància al límit de l'atmosfera."@ca-valencia .

wmdr:573 a skos:Concept ;
    qudt:applicableUnit unit:W-PER-M2 ;
        rdfs:label       "Downward short-wave irradiance"@en ,
                         "Irradiancia de onda corta descendente"@es ,
                         "Irradiància d'ona curta descendent"@ca-valencia ;
        dcterms:description  "Flux density of downwelling short-wave solar radiation, at the top of the atmosphere or a specified level within the atmosphere, including the Earth surface. [The term 'global (downward) shortwave irradiance' is sometimes used to specify that this flux is the sum of direct and diffuse components.]"@en ;
        rdfs:comment "Global solar radiation at the surface."@en ,
                     "Radiación solar global en superficie."@es ,
                     "Radiació solar global en superfície."@ca-valencia ;
        skos:notation    "573" ;
        dcterms:replaces wmdr:12312 .

