bufr4_b13:083 a skos:Concept ;
    qudt:applicableUnit unit:MilliGM-PER-L ;
        rdfs:label       "Dissolved oxygen"@en ,
                         "Oxígeno disuelto"@es ,
                         "Oxigen dissolt"@ca-valencia ;
        <http://codes.wmo.int/def/bufr4/dataWidth_Bits>
                15 ;
        <http://codes.wmo.int/def/bufr4/fxy>
                "013083" ;
        <http://codes.wmo.int/def/bufr4/referenceValue>
                0 ;
        <http://codes.wmo.int/def/bufr4/scale>
                6 ;
        <http://codes.wmo.int/def/common/unit>
                <http://codes.wmo.int/common/unit/kg_m-3> ;
        rdfs:comment "Concentration of oxygen dissolved in the water, in mg/L."@en ,
                     "Concentración de oxígeno disuelto en el agua, en mg/L."@es ,
                     "Concentració d'oxigen dissolt en l'aigua, en mg/L."@ca-valencia ;
        skos:notation    "083" ;
        dcterms:replaces s4watr:Oxygen .

wmo:windDirection a qudt:SpaceAndTimeQuantityKind , qudt:QuantityKind , skos:Concept ;
        qudt:applicableUnit unit:DEG ;
        rdfs:label       "Wind direction"@en ,
                         "Dirección del viento"@es ,
                         "Direcció del vent"@ca-valencia ;
        <http://codes.wmo.int/def/common/dimensions>
                "dimensionless" ;
        <http://codes.wmo.int/def/common/discipline>
                "Meteorological quantity kinds" ;
        dcterms:description  "Direction from which wind is blowing."@en ,
                             "Dirección desde la que sopla el viento."@es ,
                             "Direcció des de la qual bufa el vent."@ca-valencia ;
        skos:notation    "windDirection" .

wmo:windSpeed a qudt:SpaceAndTimeQuantityKind , qudt:QuantityKind , skos:Concept ;
        qudt:applicableUnit unit:M-PER-SEC ;
        rdfs:label       "Wind speed"@en ,
                         "Velocidad del viento"@es ,
                         "Velocitat del vent"@ca-valencia ;
        <http://codes.wmo.int/def/common/dimensions>
                "LT-1" ;
        <http://codes.wmo.int/def/common/discipline>
                "Meteorological quantity kinds" ;
        dcterms:description  "Ratio of the distance covered by the air to the time taken to cover it. The instantaneous speed corresponds to the case of an infinitely small time interval. The mean speed corresponds to the case of a finite time interval. It is one component of wind velocity, the other being wind direction)."@en ,
                             "Relación entre la distancia recorrida por el aire y el tiempo empleado en recorrerla. La velocidad instantánea corresponde al caso de un intervalo de tiempo infinitamente pequeño. La velocidad media corresponde al caso de un intervalo de tiempo finito. Es uno de los componentes de la velocidad del viento; el otro es la dirección del viento."@es ,
                             "Relació entre la distància recorreguda per l'aire i el temps emprat a recórrer-la. La velocitat instantània correspon al cas d'un interval de temps infinitament xicotet. La velocitat mitjana correspon al cas d'un interval de temps finit. És un dels components de la velocitat del vent; l'altre és la direcció del vent."@ca-valencia ;
        skos:notation    "windSpeed" .

sst:66851a3 a skos:Concept ;
  skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/SummaryStatisticType/2.1.2/> ;
  dcterms:replaces sst:median ;
  skos:notation "Median"@en ;
  rdfs:label "Median"@en ,
                 "Mediana"@es ,
                 "Mediana"@ca-valencia ;
  skos:definition "The middle value of an ordered set of values. For an even number of values, it is the arithmetic mean of the two middle values."@en , "El valor central de un conjunto de valores ordenados. Si el número de valores es par, es la media aritmética de los dos valores centrales."@es , "El valor central d’un conjunt de valors ordenats. Si el nombre de valors és parell, és la mitjana aritmètica dels dos valors centrals."@ca-valencia .

sst:7975ed0 a skos:Concept ;
  skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/SummaryStatisticType/2.1.2/> ;
  skos:notation "ArithmeticMean"@en ;
  rdfs:label "Arithmetic Mean"@en ,
                 "Media aritmética"@es ,
                 "Mitjana aritmètica"@ca-valencia ;
  skos:definition "Mathematical average of a set of values, calculated by adding the values together and dividing by their count."@en ,
                "Promedio matemático de un conjunto de valores, calculado sumando los valores y dividiéndolos por su número."@es ,
                "Mitjana matemàtica d'un conjunt de valors, calculada sumant els valors i dividint-los pel seu nombre."@ca-valencia .

sst:a7f7339 a skos:Concept ;
  skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/SummaryStatisticType/2.1.2/> ;
  skos:notation "InterquartileRange"@en ;
  rdfs:label "Interquartile range"@en ,
             "Rango intercuartílico"@es ,
             "Rang interquartílic"@ca-valencia ;
  skos:definition "The range between the first and third quartile values."@en ,
                  "El intervalo entre el primer y el tercer cuartil."@es ,
                  "L'interval entre el primer i el tercer quartil."@ca-valencia ;
  dcterms:replaces nb:iqr .

sst:5dc5781 a skos:Concept ;
  skos:inScheme <http://rdf-vocabulary.ddialliance.org/cv/SummaryStatisticType/2.1.2/> ;
  skos:notation "MedianAbsoluteDeviation"@en ;
  rdfs:label "Median absolute deviation"@en ,
             "Desviación absoluta mediana"@es ,
             "Desviació absoluta mediana"@ca-valencia ;
  skos:definition "The median absolute deviation from the median. Measure of statistical dispersion around the median."@en ,
                  "La mediana de las desviaciones absolutas respecto a la mediana. Medida de la dispersión estadística en torno a la mediana."@es ,
                  "La mediana de les desviacions absolutes respecte a la mediana. Mesura de la dispersió estadística al voltant de la mediana."@ca-valencia ;
  dcterms:replaces nb:mad_median .

