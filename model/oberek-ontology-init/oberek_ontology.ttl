        <http://codes.wmo.int/def/grib2/discipline>
                <http://codes.wmo.int/grib2/codeflag/0.0/2> ;
        <http://codes.wmo.int/def/grib2/parameter>
                6 ;
        <http://metarelate.net/vocabulary/index.html#identifier>
                <http://codes.wmo.int/def/common/edition> , <http://codes.wmo.int/def/grib2/category> , <http://codes.wmo.int/def/grib2/parameter> , <http://codes.wmo.int/def/grib2/discipline> ;
        dcterms:description  "Evapotranspiration"@en ;
        rdfs:label   "Evapotranspiration"@en ,
                         "Evapotranspiración"@es ,
                         "Evapotranspiració"@ca-valencia ;
        owl:deprecated   true ;
        dcterms:isReplacedBy bufr4_b13:031 ;
        dcterms:modified "2026-10-13"^^xsd:date ;
        skos:historyNote "Deprecated in OBEREK on 2026-10-13: the station reports a daily ETo amount in mm, not a rate."@en ,
                         "Obsoleto en OBEREK desde el 2026-10-13: la estación da una cantidad diaria de ETo en mm, no una tasa."@es ,
                         "Obsolet en OBEREK des del 2026-10-13: l'estació dona una quantitat diària d'ETo en mm, no una taxa."@ca-valencia .

bufr4_b13:031 a skos:Concept ;
    qudt:applicableUnit unit:MilliM ;
        rdfs:label       "Evapotranspiration"@en ,
                         "Evapotranspiración"@es ,
                         "Evapotranspiració"@ca-valencia ;
        <http://codes.wmo.int/def/bufr4/dataWidth_Bits>
                7 ;
        <http://codes.wmo.int/def/bufr4/fxy>
                "013031" ;
        <http://codes.wmo.int/def/bufr4/referenceValue>
                0 ;
        <http://codes.wmo.int/def/bufr4/scale>
                0 ;
        <http://codes.wmo.int/def/common/unit>
                <http://codes.wmo.int/common/unit/kg_m-2> ;
        rdfs:comment "Reference evapotranspiration (ETo) since 00:00."@en ,
