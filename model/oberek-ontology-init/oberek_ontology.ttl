    qudt:applicableUnit unit:MilliM ;
        rdfs:label       "Evapotranspiration"@en ,
                         "Evapotranspiración"@es ,
                         "Evapotranspiració"@ca-valencia ;
        <http://codes.wmo.int/def/common/edition>
                <http://codes.wmo.int/codeform/grib2> ;
        <http://codes.wmo.int/def/common/unit>
                <http://codes.wmo.int/common/unit/kg-2_s-1> ;
        <http://codes.wmo.int/def/grib2/category>
